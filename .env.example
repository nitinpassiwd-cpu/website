# ============================================================================
# ENVIRONMENT VARIABLES — copy this file to ".env" in the SAME folder
# (backend/.env) and fill in real values. NEVER commit the real ".env" file.
# ============================================================================

# ---------------------------------------------------------------------------
# RAZORPAY  (https://dashboard.razorpay.com/app/keys)
# ---------------------------------------------------------------------------
# Key ID is PUBLIC — it is safe to send to the browser.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
# Key Secret is PRIVATE — used only on the backend to create orders and
# verify payment signatures. NEVER expose this in frontend code.
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# ---------------------------------------------------------------------------
# PRODUCT
# ---------------------------------------------------------------------------
PRODUCT_NAME=100 AI Tools That Can Save You 10 Hours Every Week
# Price in whole Rupees (e.g. 99 = ₹99). The backend converts this to
# paise automatically when creating the Razorpay order.
PRODUCT_PRICE=99
PRODUCT_CURRENCY=INR

# ---------------------------------------------------------------------------
# SECURE DOWNLOAD
# ---------------------------------------------------------------------------
# Absolute or relative path to the real ebook file on the server.
# This folder must NOT be publicly served — only the /api/download route
# (which checks a signed token) may read from it.
EBOOK_FILE_PATH=../protected/100-ai-tools-ebook.pdf
# Long random string used to sign download tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# How long a download link stays valid after it is issued.
DOWNLOAD_LINK_EXPIRY_HOURS=48

# ---------------------------------------------------------------------------
# WEBSITE
# ---------------------------------------------------------------------------
# Used to build absolute links in emails and for CORS allow-listing.
WEBSITE_DOMAIN=https://yourdomain.com
PORT=4242

# ---------------------------------------------------------------------------
# EMAIL DELIVERY (SMTP — works with Gmail, SendGrid, Postmark, Amazon SES,
# Mailgun, Resend, etc. Fill in whichever provider you use.)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=YOUR_SMTP_USERNAME
EMAIL_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM="100 AI Tools <no-reply@yourdomain.com>"
SUPPORT_EMAIL=support@yourdomain.com

# ---------------------------------------------------------------------------
# ANALYTICS (public IDs — safe to expose, but keep them in one place)
# ---------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=YOUR_GOOGLE_ANALYTICS_ID
META_PIXEL_ID=YOUR_META_PIXEL_ID
